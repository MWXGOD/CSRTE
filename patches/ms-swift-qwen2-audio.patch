+    def _get_processor_call_config(self) -> Dict[str, Any]:
+        processor_parameters = inspect.signature(self.processor.__call__).parameters
+        has_var_kwargs = any(p.kind == inspect.Parameter.VAR_KEYWORD for p in processor_parameters.values())
+        if 'audio' in processor_parameters:
+            audio_key = 'audio'
+        elif 'audios' in processor_parameters or has_var_kwargs:
+            audio_key = 'audios'
+        else:
+            audio_key = 'audio'
+        return {
+            'audio_key': audio_key,
+            'supports_text_kwargs': 'text_kwargs' in processor_parameters or has_var_kwargs,
+            'supports_return_attention_mask': 'return_attention_mask' in processor_parameters,
+        }
