+
+        encoded = {'input_ids': input_ids, 'labels': labels, 'loss_scale': loss_scale}
+        if input_features:
+            encoded['input_features'] = torch.concat(input_features)
+        if feature_attention_mask:
+            encoded['feature_attention_mask'] = torch.concat(feature_attention_mask)
+        return encoded
