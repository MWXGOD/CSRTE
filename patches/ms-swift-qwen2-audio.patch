+    def _build_processor_kwargs(self,
+                                context: str,
+                                context_audios: List[Any],
+                                processor_config: Dict[str, Any]) -> Dict[str, Any]:
+        processor_kwargs = {
+            'text': context,
+            'sampling_rate': self.sampling_rate,
+            'return_tensors': 'pt',
+        }
+        processor_kwargs[processor_config['audio_key']] = context_audios
+        if processor_config['supports_text_kwargs']:
+            processor_kwargs['text_kwargs'] = {'add_special_tokens': False}
+        else:
+            processor_kwargs['add_special_tokens'] = False
+        return processor_kwargs
