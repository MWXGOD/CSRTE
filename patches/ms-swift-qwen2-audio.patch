+    def _encode_context_list_with_processor(self,
+                                            context_list: List[Context],
+                                            loss_scale_list: Optional[List[float]] = None,
+                                            audios: Optional[List[Any]] = None) -> Dict[str, Any]:
+        input_ids: List[int] = []
+        labels: List[int] = []
+        loss_scale: List[float] = []
+        if loss_scale_list is None:
+            loss_scale_list = [0.] * len(context_list)
+        audios = audios or []
+        audio_idx = 0
+        audio_token_id = self._tokenize('<|AUDIO|>')[0]
+        input_features = []
+        feature_attention_mask = []
+        processor_config = self._get_processor_call_config()
+
+        for context, loss_weight in zip(context_list, loss_scale_list):
+            if isinstance(context, str) and '<|AUDIO|>' in context:
+                num_audios = context.count('<|AUDIO|>')
+                context_audios = audios[audio_idx:audio_idx + num_audios]
+                audio_idx += num_audios
+                if not context_audios:
+                    raise ValueError(f'Audio placeholder found but no audio data is available. context: {context!r}')
+
+                processor_kwargs = self._build_processor_kwargs(context, context_audios, processor_config)
+                processor_outputs = self.processor(**processor_kwargs)
+                torch_dtype = getattr(getattr(self, 'model_info', None), 'torch_dtype', None)
+                if torch_dtype is not None:
+                    processor_outputs = to_float_dtype(processor_outputs, torch_dtype)
+                token_list = processor_outputs['input_ids'][0].tolist()
+                if processor_outputs.get('input_features') is not None:
+                    input_features.append(processor_outputs['input_features'])
+                if processor_outputs.get('feature_attention_mask') is not None:
+                    feature_attention_mask.append(processor_outputs['feature_attention_mask'])
+            elif isinstance(context, str):
+                token_list = self._tokenize(context)
+            else:
+                token_list = context
+                # A generated response can occasionally contain the audio placeholder token.
+                # It has no matching audio feature and would make Qwen2-Audio fail in forward.
+                if audio_token_id in token_list:
+                    token_list = [token for token in token_list if token != audio_token_id]
+
+            input_ids += token_list
+            if loss_weight > 0.0:
+                token_labels = token_list.copy()
+                if isinstance(context, str) and '<|AUDIO|>' in context:
+                    token_labels = [token if token != audio_token_id else -100 for token in token_labels]
+                labels += token_labels
+            else:
+                labels += [-100] * len(token_list)
+            if not self.loss_scale.is_loss_scale_binary:
+                loss_scale.extend([loss_weight] * len(token_list))
